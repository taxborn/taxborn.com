---
import Head from "./Head.astro";
import Navigation from "./Navigation.astro";
import Footer from "./Footer.astro";

interface Props {
    title: string;
}

const { title, ...props } = Astro.props;
---

<html lang="en">
    <head>
        <Head title={title} />
        <slot name="head" />
    </head>
    <body>
        <header>
            <Navigation />
            <slot name="header" />
        </header>
        <main>
            <slot />
        </main>
        <footer>
            <Footer />
            <slot name="footer" />
        </footer>
    </body>
</html>
